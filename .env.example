# System Settings
APP_ENV=development
SECRET_KEY=generate-a-secure-random-secret-key-here
FACE_MATCH_THRESHOLD=0.60  # Cosine similarity threshold (higher = stricter)

# Database Config
DATABASE_URL=mongodb://localhost:27017
DATABASE_NAME=missing_person_db

# Email Service Config (Optional - for alerting)
EMAIL_ENABLED=false
MAX_NOTIFICATION_ATTEMPTS=3
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=app-password-here
SMTP_FROM_EMAIL=alerts@example.com

# Map Config
DEFAULT_LATITUDE=28.6139   # Default center: New Delhi
DEFAULT_LONGITUDE=77.2090
DEFAULT_ZOOM=12

# Development Seed Users (used by database/seed_users.py)
# Override these for local testing; never use in production.
DEV_ADMIN_NAME=Admin
DEV_ADMIN_EMAIL=admin@missingtracker.com
DEV_ADMIN_PASSWORD=change-me-admin
DEV_OFFICER_NAME=Officer
DEV_OFFICER_EMAIL=officer@missingtracker.com
DEV_OFFICER_PASSWORD=change-me-officer

# Resource & Safety Limits (Phase 24 Hardening)
MAX_IMAGE_SIZE_MB=5
MAX_VIDEO_SIZE_MB=100
MAX_VIDEO_FRAMES_TO_PROCESS=500
VIDEO_SAMPLE_INTERVAL_SECONDS=1.0

# MediaPipe Face Landmarker (Phase 12+)
# Download the .task model file from Google's MediaPipe Model Garden:
#   https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/latest/face_landmarker.task
# Place it at: data/models/face_landmarker.task (default)
MEDIAPIPE_MODEL_PATH=data/models/face_landmarker.task
MEDIAPIPE_NUM_FACES=5
MEDIAPIPE_MIN_DETECTION_CONF=0.5
MEDIAPIPE_MIN_PRESENCE_CONF=0.5
MEDIAPIPE_MIN_TRACKING_CONF=0.5
